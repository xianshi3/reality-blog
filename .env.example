# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 服务端写操作（文章/资料/图片）与 AI 聊天跨实例限流，不配置则写接口与限流降级

# 管理员邮箱（可选但强烈建议配置）
# 配置后后台页面与写接口仅允许该邮箱的登录用户，防止其他注册用户越权
ADMIN_EMAIL=admin@example.com

# AI Chat API (ZhipuAI / GLM)
ZHIPU_API_KEY=your-zhipu-api-key

# GitHub 项目展示（可选，不配置则使用未认证 API，每小时限 60 次）
GITHUB_TOKEN=your-github-personal-token

# Site URL (sitemap / robots / SEO metadata; use https://www.example.com -- bare domains are normalized to www)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
